# =====================================================================
# openInvest .env.example
# =====================================================================
# `cp .env.example .env` 之后填上你需要的字段。下面分了三块：
#   1. 必填（不填就跑不起来）
#   2. 推荐填（提升体验，但留空也能跑）
#   3. 调参（有合理默认值，一般不动）

# =====================================================================
# 1. 必填
# =====================================================================

# Direct 路径（Web GUI / cron / 任意 agent run_committee）必须有 LLM key
# Coordinator 路径（Claude Code skill prepare_committee）不需要 key，可留空
#
# 支持任意 OpenAI 兼容 API（DeepSeek / 千问 / 智谱 / Kimi 等）。
# 推荐用 LLM_* 通用变量，DEEPSEEK_* 保留作向后兼容（老 fork 用户不需要迁移）。
#
# === 示例 1：DeepSeek（默认） ===
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
#
# === 示例 2：千问（Aliyun DashScope，OpenAI 兼容模式） ===
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# LLM_MODEL=qwen-max
#
# === 示例 3：智谱 AI ===
# LLM_API_KEY=xxx
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas
# LLM_MODEL=glm-4-flash
#
# LLM_PROVIDER 一般不动（默认 openai，给 DSPy/litellm 用）；
# 如果你的 LLM 不是 OpenAI 兼容协议，请在 utils/llm.py 加分支。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# === 向后兼容（老 fork 用户保持原样即可，LLM_* 留空就走这里） ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# =====================================================================
# 2. 推荐填（功能开关）
# =====================================================================

# --- 本地双击启动脚本（start-invest-backend.bat）---
# 可选。复制为 .env 后按本机路径修改，避免每次手动 set 环境变量。
# OPENINVEST_ROOT 留空时默认使用 bat 所在目录。
# OPENINVEST_PYTHON 留空时优先使用 .venv\Scripts\python.exe；再没有则回退 uv run python。
OPENINVEST_ROOT=
# 示例：OPENINVEST_PYTHON=D:\Python\Python310\python.exe
OPENINVEST_PYTHON=
# 示例：OPENINVEST_UV=C:\Users\you\.local\bin\uv.exe
OPENINVEST_UV=
OPENINVEST_LOG_DIR=logs
OPENINVEST_RESTART_EXISTING=1
OPENINVEST_START_WINDOW=1
OPENINVEST_WINDOW_POLL_MS=1000
# 默认不启动可选 HTTP 后端；桌面窗口走本地文件和 Python 直调。
OPENINVEST_START_BACKEND=0
INVEST_BACKEND_HOST=127.0.0.1
INVEST_BACKEND_PORT=

# --- 邮件通知（cron daily_report 完成后发委员会摘要）---
# Gmail 必须先开 2FA 再去 https://myaccount.google.com/apppasswords 生成 16 位
# App Password —— 不是登录密码！留空则不发邮件
EMAIL_SENDER=
EMAIL_PASSWORD=
# 报告发到哪个邮箱（不填则发给 EMAIL_SENDER 自己）
DIGEST_EMAIL_TO=

# --- 黄金渠道（如果你持有积存金/纸黄金）---
# 优先级：strategy.target_assets[GC=F] 字段 > 这两个 env > 默认"黄金（自营）"
# 例：浙商积存金 / 工行积存金 / 招行积存金
INVEST_GOLD_CHANNEL=
INVEST_GOLD_DISPLAY=

# =====================================================================
# 3. 调参（一般不动）
# =====================================================================

# --- Web API ---
# Vite dev server (localhost:5173) 放行跨域；生产保持 0
INVEST_WEB_DEV_CORS=0
# 监听地址 / 端口（默认 127.0.0.1:8765；公网入口靠 Caddy 反代）
INVEST_WEB_HOST=127.0.0.1
INVEST_WEB_PORT=8765

# --- Skill GUI 提示 ---
# off / 0 / false → doctor 不告诉 agent "项目自带 Web GUI"，避免明确不要 GUI
# 的高级用户被反复推销
INVEST_GUI_NUDGE=

# --- LLM 调参 ---
# 老变量（保留兼容）：DeepSeek 模型（deepseek-v4-flash 默认/非 thinking；
# deepseek-v4-pro 慢但更准）。旧名 deepseek-chat/deepseek-reasoner 已 deprecated。
# 新用户优先用上面的 LLM_MODEL；这里留空即可。
DEEPSEEK_MODEL=deepseek-v4-flash
# CIO temperature（默认 0.2，越低越保守）
INVEST_LLM_TEMPERATURE=0.2
# 限流重试参数
INVEST_LLM_MAX_ATTEMPTS=3
INVEST_LLM_BASE_DELAY=2.0
INVEST_LLM_MAX_DELAY=30.0

# --- Dreaming（长期记忆 → 洞察）---
# 1 = Deep Sleep 通过阈值的洞察会再走一次 LLM verify pass（更严格但烧 token）
INVEST_DREAMING_LLM_VERIFY=0

# --- 事件感知层（ADR-006，2026-05 加）---
# 默认 ON：jobs/event_watch 每 30 分钟拉新闻 → 归一化 → 命中触发委员会 + 邮件，
# 委员会跑时把相关事件 brief 注入 Macro Strategist prompt（其他 3 角色不污染）。
# 明确不要 → 设 false / 0 / off：
INVEST_EVENT_RAG_ENABLED=true
# 召回时间窗（天）
INVEST_EVENT_RAG_WINDOW_DAYS=7
# 召回最低严重度 (low/mid/high)
INVEST_EVENT_RAG_MIN_SEVERITY=mid
# 召回 top-K 事件
INVEST_EVENT_RAG_TOP_K=8
# event_watch job 每次拉新闻的最大条数（per source）
INVEST_EVENT_MAX_PER_SOURCE=15
# 事件最低严重度才触发委员会重跑（low/mid/high）
INVEST_EVENT_MIN_SEVERITY=mid


# --- A股持仓止盈止损模型 ---
# 这些参数会被 jobs/market_monitor.py 读取，用于已持仓标的的固定持仓纪律。
# 优先读取 INVEST_A_SHARE_SECTOR_EXIT_POLICIES 的板块级参数；下面五个参数只作兜底。
# 建议在本地 .env 中按回测结果重新配置；.env.example 只保留示例，不放个人真实调参。
# INVEST_A_SHARE_POSITION_MAX_LOSS_PCT: 单笔持仓最大亏损百分比上限，例如 5 表示最多约亏 5% 触发纪律止损。
# INVEST_A_SHARE_POSITION_STOP_ATR_MULT: ATR 止损倍数，和最大亏损上限一起决定初始硬止损，取两者更紧的一侧。
# INVEST_A_SHARE_POSITION_TAKE_PROFIT_R1: 第一止盈 R 倍数，达到后先卖出部分仓位锁定利润。
# INVEST_A_SHARE_POSITION_TAKE_PROFIT_R2: 第二止盈 R 倍数，达到后卖出剩余仓位。
# INVEST_A_SHARE_POSITION_TRAIL_ATR_MULT: 追踪止损 ATR 倍数，收盘后只允许把有效止损线上移，不允许下移。
INVEST_A_SHARE_POSITION_MAX_LOSS_PCT=5.0
INVEST_A_SHARE_POSITION_STOP_ATR_MULT=1.6
INVEST_A_SHARE_POSITION_TAKE_PROFIT_R1=1.5
INVEST_A_SHARE_POSITION_TAKE_PROFIT_R2=3.5
INVEST_A_SHARE_POSITION_TRAIL_ATR_MULT=3.0
# 板块级参数：key 是 sector，value 是该板块独立回测出的持仓纪律参数。
# 每周任务会从 jobs/market_monitor_config.json 的 holdings+watchlist 中按板块取 A 股样本，
# 每个板块最多 INVEST_EXIT_PARAM_OPT_MAX_SYMBOLS_PER_SECTOR 只，写回这个 JSON。
# 注意：这仍然只用于已有持仓止盈止损；右侧入场仍由 ENTRY_EXIT_POINTS/optimizer 的条件期望确认。
INVEST_A_SHARE_SECTOR_EXIT_POLICIES=
# --- A股止盈止损离散优化（每周自动调参）---
# jobs/weekly_exit_param_optimization.py 每周读取最近一个月数据，构造有限参数空间 Theta，
# 以 risk-adjusted expected utility 选择最优参数：objective_score 为主，卖出胜率使用 Wilson 下界和样本可靠性收缩，避免小样本裸胜率误导。
# INVEST_EXIT_PARAM_OPT_SYMBOLS: 当 monitor config 不可用时的兜底样本池，正常情况下优先用持仓+关注列表按板块分组。
# INVEST_EXIT_PARAM_OPT_DAYS: 每次回看天数，31 约等于最近一个月自然日。
# INVEST_EXIT_PARAM_OPT_INITIAL_CASH: 回测初始现金，用于现金约束和手数约束。
# INVEST_EXIT_PARAM_OPT_FEE_RATE: 单边手续费率，万五=0.0005。
# INVEST_EXIT_PARAM_OPT_MAX_OPS: 单只标的一天最多操作次数，A股场景建议 0-5。
# INVEST_EXIT_PARAM_OPT_UPDATE_ENV: 1=每周把最优五个持仓纪律参数写回 .env；0=只输出报告。
# INVEST_EXIT_PARAM_OPT_HISTORY_PERIOD: 拉取历史行情窗口，默认2y，用于指标暖身。
# INVEST_EXIT_PARAM_OPT_MAX_SYMBOLS_PER_SECTOR: 每个板块最多选几个样本参与优化，A股板块内趋势趋同，默认最多3只。
# INVEST_EXIT_PARAM_OPT_SECTORS: 可选，只优化指定板块，逗号分隔；留空则优化全部持仓/关注板块。
# 输出到 .env 的板块 JSON 会包含 policy_quality_score、sell_win_rate_lower、profit_factor、conservative_sell_expectancy_cny 等校准字段。
INVEST_EXIT_PARAM_OPT_SYMBOLS=
INVEST_EXIT_PARAM_OPT_DAYS=31
INVEST_EXIT_PARAM_OPT_INITIAL_CASH=100000
INVEST_EXIT_PARAM_OPT_FEE_RATE=0.0005
INVEST_EXIT_PARAM_OPT_MAX_OPS=5
INVEST_EXIT_PARAM_OPT_UPDATE_ENV=1
INVEST_EXIT_PARAM_OPT_HISTORY_PERIOD=2y
INVEST_EXIT_PARAM_OPT_MAX_SYMBOLS_PER_SECTOR=3
INVEST_EXIT_PARAM_OPT_SECTORS=
# --- 数据陈旧告警 ---
# 价格数据超过 N 天 → daily_report 加 warning（不阻断委员会）
INVEST_PRICE_STALE_DAYS=3
# 价格数据超过 N 天 → 硬终止 daily_report（避免基于陈旧价格做决策）
INVEST_HARD_ABORT_STALE_DAYS=7

# --- PnL 自动 push（可选，仅作者使用）---
# 1 = 每 2h 把 docs/pnl_chart.svg force-push 到 pnl-data 分支供 README 引用
# fork 用户保持 0 即可
INVEST_PNL_AUTOPUSH=0
GITHUB_TOKEN=
INVEST_PNL_PUSH_BRANCH=pnl-data
